# ============================================================
# 会议纪要助手 - 环境配置示例
# 使用方法：复制本文件为 .env，填入你自己的密钥即可
#   copy .env.example .env
# 注意：.env 已被 .gitignore 排除，不会提交到仓库，请放心填写
# ============================================================

# ========== LLM 大模型接口（必填）==========
# 这里以阿里云百炼（DashScope）OpenAI 兼容接口为例
OPENAI_API_KEY=sk-在这里填你的密钥
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名：可换 qwen-turbo / qwen-plus / qwen-max
LLM_MODEL=qwen-turbo
# 请求容错
LLM_TIMEOUT=30
LLM_MAX_RETRY=3
LLM_RATE_LIMIT=10
# 是否生成英文双语文稿（false 可加快速度）
TRANSLATE_ENABLED=true

# ========== 邮件发送（选填，不填则邮件功能不可用）==========
# QQ 邮箱为例：MY_EMAIL_PASS 填「授权码」，不是登录密码
MY_EMAIL=
MY_EMAIL_PASS=
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465

# ========== 语音转写 Whisper 配置 ==========
# 模型规格：tiny / base / small / medium / large-v3
#   体积与准确度递增；tiny 约 75MB，medium 约 1.5GB
#   首次运行会自动下载到 ./models/，无需手动准备
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_VAD=true
WHISPER_VAD_MIN_SILENCE_MS=500
AUDIO_CHUNK_SECONDS=300
TRANSCRIBE_CACHE_ENABLED=true
CACHE_EXPIRE_DAYS=7

# ========== 目录配置（一般无需修改）==========
RECORD_ROOT=./records
CHUNK_CACHE_DIR=chunks_cache
TRANS_CACHE_DIR=trans_cache
MODELS_ROOT=./models

# ========== Hugging Face 镜像（国内加速，强烈建议保留）==========
HF_ENDPOINT=https://hf-mirror.com
# 禁用 Xet 协议：国内镜像不支持，开启会导致下载 401，务必保持为 1
HF_HUB_DISABLE_XET=1

# ========== 说话人分离（声纹分离）==========
# true=区分发言人，false=普通转写；模型缺失时自动降级为普通转写
SPEAKER_DIARIZATION_ENABLED=true
# 聚类阈值：越大越倾向合并（人数偏少），越小越容易拆成多人
SPEAKER_CLUSTER_THRESHOLD=0.7
# 已知人数时填正整数，-1=自动判断
SPEAKER_NUM_CLUSTERS=-1
SPEAKER_MIN_DURATION_ON=0.3
SPEAKER_MIN_DURATION_OFF=0.5
DIARIZATION_MODEL_DIR=./models/speaker-diarization

# ========== 说话人姓名识别 ==========
SPEAKER_STORE_ENABLED=true
# 声纹匹配阈值（余弦相似度，越大越严格）
SPEAKER_MATCH_THRESHOLD=0.55
# 声纹增量学习融合系数
SPEAKER_UPDATE_ALPHA=0.35
# 是否允许大模型从对话内容推断说话人姓名（需人工确认）
SPEAKER_AI_NAME_ENABLED=true
